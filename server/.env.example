HOST=127.0.0.1
PORT=8787
DEEPSEEK_API_KEY=replace-with-your-provider-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TEXT_MODEL=deepseek-flash
# Generate a long random token; enter the same token in the iOS service settings.
APP_ACCESS_TOKEN=replace-with-a-random-token-at-least-32-characters
REQUEST_TIMEOUT_MS=120000
RATE_LIMIT_PER_HOUR=60
MAX_CONCURRENT_REQUESTS=3
