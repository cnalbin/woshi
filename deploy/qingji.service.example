[Unit]
Description=QingJi private AI API
After=network.target

[Service]
Type=simple
User=qingji
WorkingDirectory=/opt/qingji/server
EnvironmentFile=/opt/qingji/server/.env
ExecStart=/opt/qingji/server/.venv/bin/uvicorn qingji.main:app --host 127.0.0.1 --port 8787 --no-access-log
StateDirectory=qingji
Environment=PHOTO_DIRECTORY=/var/lib/qingji/photos
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
