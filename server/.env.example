# Empty until you are ready to enable AI. Backup works without this key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TEXT_MODEL=deepseek-flash
# Enable the free quota and membership UI. Apple purchases also require verification configuration.
MEMBERSHIP_ENABLED=false
# APPLE_BUNDLE_ID=com.cnalbin.qingji
# APPLE_SUBSCRIPTION_PRODUCT=com.cnalbin.qingji.membership.monthly
# APPLE_ENVIRONMENT=Production
# APPLE_APP_ID=1234567890
# APPLE_ROOT_CERTIFICATES=/data/photos/.apple/AppleRootCA-G3.cer
# Only for temporary access by old app versions. Leave disabled for per-user access.
ENABLE_LEGACY_TOKEN=false
REQUEST_TIMEOUT_SECONDS=120
RATE_LIMIT_PER_HOUR=60
MAX_CONCURRENT_REQUESTS=3
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=qingji
MYSQL_USER=qingji
MYSQL_PASSWORD=
# Optional CA path inside the container for TLS to MySQL.
# MYSQL_SSL_CA=/run/mysql-ca.pem
